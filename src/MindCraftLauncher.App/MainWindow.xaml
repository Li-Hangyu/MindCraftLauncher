<Window x:Class="MindCraftLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:MindCraftLauncher.App.Views"
        Title="Mind Craft Launcher"
        Width="960" Height="620"
        MinWidth="850" MinHeight="550"
        PreviewKeyDown="OnPreviewKeyDown"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource BrushText}"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource BrushWindow}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 最外层：1px 描边，最大化时留出系统边框的补偿 margin 由代码设置 -->
    <Border x:Name="Shell" Background="{DynamicResource BrushWindowGradient}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- ============ 顶部标题条（拖动区） ============ -->
            <Grid Grid.Row="0" Background="{DynamicResource BrushTopBar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="32" Height="32" CornerRadius="9"
                            Background="{DynamicResource BrushAccentGradient}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.55" Color="#FF6C8CFF" />
                        </Border.Effect>
                        <TextBlock Text="M" FontSize="17" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MIND CRAFT" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushText}" />
                        <TextBlock Text="L A U N C H E R" FontSize="8.5"
                                   Foreground="{DynamicResource BrushTextMute}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 标题条中部：不放控件，留给拖动 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Background="{DynamicResource BrushSurfaceAlt}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0"
                                     Fill="{Binding Terracotta.LinkBrush, FallbackValue=Gray}" />
                            <TextBlock Text="{Binding Terracotta.LinkShort}" FontSize="10.5"
                                       Foreground="{DynamicResource BrushTextDim}" />
                            <Border Width="1" Height="11" Background="{DynamicResource BrushBorder}"
                                    Margin="10,0" />
                            <TextBlock Text="{Binding Redstone.AccountShort}" FontSize="10.5"
                                       Foreground="{DynamicResource BrushTextDim}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="启动游戏" Command="{Binding Launch.GameCommand}"
                            Style="{StaticResource Primary}" Padding="20,8" MinHeight="34"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="启动当前选中的版本" />

                    <Border Width="1" Height="20" Background="{DynamicResource BrushBorder}" Margin="14,0,10,0" />

                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}"
                            Click="OnMinimize" ToolTip="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#xE922;" x:Name="MaxButton" Style="{StaticResource CaptionButton}"
                            Click="OnMaximize" ToolTip="最大化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}"
                            Click="OnClose" ToolTip="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ============ 主体：左导航 + 内容 ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏 -->
                <Border Grid.Column="0" Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="0,1,1,0">
                    <Grid Margin="9,12,9,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <RadioButton x:Name="NavLaunch" Style="{StaticResource NavRailItem}" GroupName="nav"
                                         Checked="OnNav" Tag="launch" ToolTip="主页">
                                <StackPanel>
                                    <Path Style="{StaticResource NavIcon}" HorizontalAlignment="Center"
                                          Data="M 8,5 L 18.5,12 L 8,19 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="启动" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavVersions" Style="{StaticResource NavRailItem}" GroupName="nav"
                                         Checked="OnNav" Tag="versions" ToolTip="版本">
                                <StackPanel>
                                    <Path Style="{StaticResource NavIcon}" HorizontalAlignment="Center"
                                          Data="M 12,3 L 21,7.5 L 12,12 L 3,7.5 Z M 3,12 L 12,16.5 L 21,12 M 3,16.5 L 12,21 L 21,16.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="版本" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavDownload" Style="{StaticResource NavRailItem}" GroupName="nav"
                                         Checked="OnNav" Tag="download" ToolTip="下载">
                                <StackPanel>
                                    <Path Style="{StaticResource NavIcon}" HorizontalAlignment="Center"
                                          Data="M 12,4 L 12,14.5 M 7.5,10 L 12,14.5 L 16.5,10 M 4.5,19.5 L 19.5,19.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="下载" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavLabyMod" Style="{StaticResource NavRailItem}" GroupName="nav"
                                         Checked="OnNav" Tag="labymod" ToolTip="LabyMod 客户端下载">
                                <StackPanel>
                                    <TextBlock Text="L" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Laby" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <Border Height="1" Background="{DynamicResource BrushDivider}" Margin="8,8" />

                            <RadioButton x:Name="NavTerracotta" Style="{StaticResource NavRailItem}" GroupName="nav"
                                         Checked="OnNav" Tag="terracotta" ToolTip="陶瓦联机（EasyTier 组网）">
                                <StackPanel>
                                    <Path Style="{StaticResource NavIcon}" HorizontalAlignment="Center"
                                          Data="M 12,2.5 L 15.5,2.5 L 15.5,6 L 12,6 Z M 4,18 L 7.5,18 L 7.5,21.5 L 4,21.5 Z M 16.5,18 L 20,18 L 20,21.5 L 16.5,21.5 Z M 13.75,6 L 13.75,11.5 L 5.75,11.5 L 5.75,18 M 13.75,11.5 L 18.25,11.5 L 18.25,18"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="陶瓦" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavRedstone" Style="{StaticResource NavRailItem}" GroupName="nav"
                                         Checked="OnNav" Tag="redstone" ToolTip="红石联机（Yggdrasil 外置登录）">
                                <StackPanel>
                                    <Path Style="{StaticResource NavIcon}" HorizontalAlignment="Center"
                                          Data="M 12,3 L 19,6 L 19,12 C 19,16.4 15.9,19.6 12,21 C 8.1,19.6 5,16.4 5,12 L 5,6 Z M 12,11 L 12,15"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="红石" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavRailItem}" GroupName="nav"
                                         Checked="OnNav" Tag="settings" ToolTip="设置">
                                <StackPanel>
                                    <Path Style="{StaticResource NavIcon}" HorizontalAlignment="Center"
                                          Data="M 4,7.5 L 20,7.5 M 4,12 L 20,12 M 4,16.5 L 20,16.5 M 9,7.5 m -2,0 a 2,2 0 1 0 4,0 a 2,2 0 1 0 -4,0 M 15,12 m -2,0 a 2,2 0 1 0 4,0 a 2,2 0 1 0 -4,0 M 7.5,16.5 m -2,0 a 2,2 0 1 0 4,0 a 2,2 0 1 0 -4,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="设置" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 导航栏底部：一键换主题 -->
                        <StackPanel Grid.Row="1">
                            <Border Height="1" Background="{DynamicResource BrushDivider}" Margin="8,0,8,8" />
                            <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource Ghost}"
                                    Height="42" ToolTip="切换深浅主题">
                                <StackPanel>
                                    <Path Style="{StaticResource NavIcon}" Width="16" Height="16"
                                          HorizontalAlignment="Center"
                                          Data="M 12,4 A 8,8 0 1 1 11.99,4 Z M 12,4 L 12,20"
                                          Stroke="{DynamicResource BrushTextDim}" />
                                    <TextBlock Text="{Binding ThemeLabel}" FontSize="10" HorizontalAlignment="Center"
                                               Margin="0,3,0,0" Foreground="{DynamicResource BrushTextMute}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区：极光底 + 页面容器 -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Rectangle Fill="{DynamicResource BrushWindowGradient}" />

                    <!-- 两团柔光，纯装饰，不参与命中测试 -->
                    <Ellipse Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-330,-260,0" Fill="{DynamicResource BrushAuroraA}" IsHitTestVisible="False" />
                    <Ellipse Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-280,0,0,-300" Fill="{DynamicResource BrushAuroraB}" IsHitTestVisible="False" />

                    <Grid x:Name="ContentRoot" Margin="0">
                        <views:LaunchView x:Name="PageLaunch" Visibility="Visible" />
                        <views:VersionsView x:Name="PageVersions" Visibility="Collapsed" />
                        <views:DownloadView x:Name="PageDownload" Visibility="Collapsed" />
                        <views:LabyModView x:Name="PageLabyMod" Visibility="Collapsed" />
                        <Grid x:Name="PagePacks" Visibility="Collapsed">
                            <views:ModpackView Visibility="{Binding IsDetailVisible, Converter={StaticResource InverseBool}}" />
                            <views:ProjectDetailView DataContext="{Binding Modpacks}"
                                                     Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <views:ModView x:Name="PageMods" Visibility="Collapsed" />
                        <Grid x:Name="PageResourcePacks" Visibility="Collapsed">
                            <views:ClientPackView DataContext="{Binding ResourcePacks}"
                                                  Visibility="{Binding IsDetailVisible, Converter={StaticResource InverseBool}}" />
                            <views:ProjectDetailView DataContext="{Binding ResourcePacks}"
                                                     Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <Grid x:Name="PageShaders" Visibility="Collapsed">
                            <views:ClientPackView DataContext="{Binding Shaders}"
                                                  Visibility="{Binding IsDetailVisible, Converter={StaticResource InverseBool}}" />
                            <views:ProjectDetailView DataContext="{Binding Shaders}"
                                                     Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <views:TerracottaView x:Name="PageTerracotta" Visibility="Collapsed" />
                        <views:RedstoneView x:Name="PageRedstone" Visibility="Collapsed" />
                        <views:SettingsView x:Name="PageSettings" Visibility="Collapsed" />
                        <views:LoadingOverlay Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                              Message="{Binding LoadingMessage}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ 底部状态栏 ============ -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushOk}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="760" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5"
                               Foreground="{DynamicResource BrushTextMute}"
                               Text="Mind Craft Launcher · .NET 8 WPF 运行环境" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
