<UserControl x:Class="MindCraftLauncher.App.Views.ModpackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Modpacks}"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource ScrollablePage}">
        <StackPanel MaxWidth="1060" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="游戏与加载器" Style="{StaticResource Ghost}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="download" />
                <Button Content="整合包" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="modpacks" />
                <Button Content="模组" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="mods" />
                <Button Content="资源包" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="resourcepacks" />
                <Button Content="光影包" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="shaders" />
                <Button Content="LabyMod" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="labymod" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="4" Height="26" CornerRadius="2" Background="{DynamicResource BrushAccentGradient}"
                        VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="整合包" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="从 Modrinth 搜索安装（.mrpack）。装完是一个独立版本，会自动装好它要求的加载器，并解压 overrides 配置。" />

            <!-- 搜索 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="关键词" Style="{StaticResource Overline}" Margin="0,0,0,5" />
                            <Grid>
                                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="留空 = 按热度列全部" IsHitTestVisible="False" Margin="13,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource BrushTextMute}"
                                           Visibility="{Binding Query, Converter={StaticResource EmptyToVisible}}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="游戏版本（可空）" Style="{StaticResource Overline}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Grid.Column="4" Content="搜索" Command="{Binding SearchCommand}"
                                Style="{StaticResource Primary}" VerticalAlignment="Bottom" Padding="22,9" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BrushDivider}" Margin="0,14,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="从本地 .mrpack 安装" Command="{Binding InstallLocalCommand}" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Text="CurseForge 的 .zip 暂不支持（官方接口需要 API Key）。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="2,0,0,10" />

            <!-- 空状态 -->
            <Border Style="{StaticResource Notice}" Margin="0,0,0,12" HorizontalAlignment="Left"
                    Visibility="{Binding Hits.Count, Converter={StaticResource ZeroToVisible}}"
                    Padding="18,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▦" FontSize="20" Margin="0,0,12,0" Foreground="{DynamicResource BrushTextMute}" />
                    <StackPanel>
                        <TextBlock Text="还没有搜索结果" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Hint}" MaxWidth="620"
                                   Text="在上面输入关键词后点「搜索」。整合包数据来自 Modrinth 公开接口，不需要 API Key。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Hits}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource HitCardStyle}" GroupName="packHits"
                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}">
                            <StackPanel>
                                <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource BrushSurfaceAlt}"
                                        HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           MaxHeight="46" TextTrimming="CharacterEllipsis" FontSize="10.5"
                                           Foreground="{DynamicResource BrushTextMute}" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="可安装的版本" Style="{StaticResource SectionTitle}" />
                        <Button Content="重新读取版本" Command="{Binding LoadVersionsCommand}"
                                HorizontalAlignment="Right" Style="{StaticResource Ghost}" />
                    </Grid>
                    <ListBox Height="150" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                             DisplayMemberPath="Display" />
                    <ProgressBar Value="{Binding Progress}" Margin="0,12,0,0" />
                    <Button Content="安装所选整合包" Command="{Binding InstallCommand}"
                            Style="{StaticResource Primary}" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="22,9" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
