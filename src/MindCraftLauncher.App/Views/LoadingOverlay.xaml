<UserControl x:Class="MindCraftLauncher.App.Views.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True">
    <Grid Background="#990B0A12">
        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="14" Padding="28,24" HorizontalAlignment="Center"
                VerticalAlignment="Center" MinWidth="220">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="正在处理" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,6,0,14"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                <Ellipse Width="30" Height="30" Stroke="#00000033" StrokeThickness="2"
                         RenderTransformOrigin="0.5,0.5" Margin="0,0,0,14"
                         Visibility="{Binding Launch.IsProgressIndeterminate, Converter={StaticResource BoolToVis}}">
                    <Ellipse.RenderTransform>
                        <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.75" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <ProgressBar Height="4" Width="200" Margin="0,0,0,14" Minimum="0" Maximum="100"
                             Value="{Binding Launch.ProgressValue, Mode=OneWay}"
                             Visibility="{Binding Launch.IsProgressIndeterminate, Converter={StaticResource InverseBool}}" />
                <Button Content="取消启动" Margin="0,12,0,0" Padding="14,6" HorizontalAlignment="Center"
                        Command="{Binding Launch.CancelStartupCommand}"
                        Visibility="{Binding Launch.Busy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
