<UserControl x:Class="MindCraftLauncher.App.Views.RedstoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Redstone}"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource ScrollablePage}">
        <StackPanel MaxWidth="1060" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="4" Height="26" CornerRadius="2" Background="{DynamicResource BrushRedstoneGradient}"
                        VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="红石联机" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="红石类皮肤站的 Yggdrasil 外置登录（authlib-injector 注入）+ 服务器列表。这一页做账号认证，不组网；要异地互通请用【陶瓦联机】。" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- 左：登录 -->
                <Border Style="{StaticResource CardAccentRedstone}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="认证服务器" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Yggdrasil 地址（皮肤站首页或 /api/yggdrasil 均可）"
                                   Style="{StaticResource Overline}" Margin="0,0,0,5" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="测试连接" Command="{Binding TestServerCommand}"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding AuthServer}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" Text="{Binding ServerName}"
                                   Foreground="{DynamicResource BrushRedstone}" FontSize="11" />

                        <Border Height="1" Background="{DynamicResource BrushDivider}" Margin="0,14,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="用户名" Style="{StaticResource Overline}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding UserName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="密码" Style="{StaticResource Overline}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Password}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="登录" Command="{Binding LoginCommand}" Style="{StaticResource Redstone}"
                                    Padding="24,9" />
                            <Button Content="更新注入器" Command="{Binding UpdateInjectorCommand}" Margin="8,0,0,0" />
                            <Button Content="移除所选" Command="{Binding RemoveAccountCommand}" Style="{StaticResource Danger}"
                                    Margin="8,0,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource Notice}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding InjectorStatus}" Style="{StaticResource Hint}" FontSize="10.5" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,5,0,0"
                                           FontSize="11" Foreground="{DynamicResource BrushText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 右：账号 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="已登录的红石账号" Style="{StaticResource SectionTitle}" />
                        <ListBox Height="132" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                 DisplayMemberPath="DisplayName" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" FontSize="10.5"
                                   Text="accessToken 明文存在本机 accounts.json；换机或共享电脑请记得删账号。" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 服务器列表 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="服务器列表" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="启动器自有的 servers.json" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   FontSize="10.5" Foreground="{DynamicResource BrushTextMute}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewServerName}" />
                        <TextBox Grid.Column="2" Text="{Binding NewServerAddress}" />
                        <Button Grid.Column="4" Content="添加" Command="{Binding AddServerCommand}"
                                Style="{StaticResource Primary}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="地址支持 ip 或 ip:端口，例如陶瓦给的 10.144.144.9:51917。启动器用 --server/--port 直接连入，不改写游戏自带的 servers.dat（那是 NBT 格式）。" />

                    <ListBox Height="150" Margin="0,12,0,0" ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding SelectedServer}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushText}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding HostPort}"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                               Foreground="{DynamicResource BrushAccent}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="用这个服启动游戏" Command="{Binding DirectJoinCommand}"
                                Style="{StaticResource Primary}" Padding="20,9" />
                        <Button Content="删除所选" Command="{Binding RemoveServerCommand}" Style="{StaticResource Danger}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
