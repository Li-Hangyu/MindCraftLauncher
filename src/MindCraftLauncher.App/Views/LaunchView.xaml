<UserControl x:Class="MindCraftLauncher.App.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Launch}"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource ScrollablePage}">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

            <!-- 页头 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="4" Height="26" CornerRadius="2" Background="{DynamicResource BrushAccentGradient}"
                        VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="启动" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="你的世界，从这里开始。选择版本与账号，马上进入游戏。" />

            <!-- Hero 主视觉 -->
            <Border Style="{StaticResource CardHero}" Margin="0,18,0,16" Height="236">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧内容区 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CURRENT VERSION" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding SelectedVersionText}" Style="{StaticResource Display}"
                                   FontSize="30" Margin="0,2,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Style="{StaticResource ChipAccent}">
                                <TextBlock Text="{Binding SelectedAccount.PlayerName, FallbackValue=未选择账号}"
                                           FontSize="10.5" Foreground="{DynamicResource BrushAccent}" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding Versions.Count, StringFormat='已装 {0} 个版本'}" FontSize="10.5"
                                           Foreground="{DynamicResource BrushTextDim}" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="版本隔离" FontSize="10.5"
                                           Foreground="{DynamicResource BrushTextDim}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="▶  启动游戏" Command="{Binding GameCommand}"
                                    Style="{StaticResource Primary}" Padding="26,11" FontSize="14" MinHeight="44" />
                            <Button Content="选择版本" Padding="16,11" MinHeight="44" Margin="10,0,0,0"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="versions" />
                            <Button Content="装新版本" Style="{StaticResource Ghost}" Padding="14,11" MinHeight="44"
                                    Margin="6,0,0,0"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="download" />
                        </StackPanel>

                        <!-- 正在启动时固定占用进度区域，卡片尺寸保持不变 -->
                        <Grid Margin="0,16,0,0" Height="30"
                              Visibility="{Binding Busy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="30" Height="30" Stroke="#00000033" StrokeThickness="2"
                                     StrokeDashArray="1 0" RenderTransformOrigin="0.5,0.5"
                                     Visibility="{Binding IsProgressIndeterminate, Converter={StaticResource BoolToVis}}">
                                <Ellipse.RenderTransform>
                                    <RotateTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.75" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Grid.Column="2" Text="{Binding LoadingMessage}"
                                       Foreground="{DynamicResource BrushTextDim}"
                                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Column="2" Height="6" Minimum="0" Maximum="100"
                                         Value="{Binding ProgressValue, Mode=OneWay}" VerticalAlignment="Center"
                                         Visibility="{Binding IsProgressIndeterminate, Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </StackPanel>
                    <!-- 左侧内容区结束 -->

                    <!-- 右侧装饰：等距方块，纯视觉 (必须在左侧 StackPanel 外面) -->
                    <Grid Grid.Column="1" Width="230" Height="180" VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Canvas>
                            <Polygon Points="115,10 190,48 115,86 40,48" Fill="{DynamicResource BrushAccentGradient}" Opacity="0.95" />
                            <Polygon Points="40,48 115,86 115,168 40,130" Fill="{DynamicResource BrushAccent}" Opacity="0.55" />
                            <Polygon Points="190,48 115,86 115,168 190,130" Fill="{DynamicResource BrushAccent2}" Opacity="0.75" />
                            <Polygon Points="115,10 190,48 115,86 40,48" Fill="White" Opacity="0.10" />
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="浏览游戏版本  ›" HorizontalContentAlignment="Left" Padding="16,12"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="versions" />
                <Button Grid.Column="2" Content="下载新版本  ›" HorizontalContentAlignment="Left" Padding="16,12"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="download" />
                <Button Grid.Column="4" Content="探索整合包  ›" HorizontalContentAlignment="Left" Padding="16,12"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="modpacks" />
            </Grid>

            <!-- 三张状态卡 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Height="112">
                    <StackPanel>
                        <TextBlock Text="已安装版本" Style="{StaticResource Overline}" Margin="0" />
                        <TextBlock Text="{Binding Versions.Count}" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushText}" Margin="0,4,0,0" />
                        <TextBlock Text="在【版本】页管理" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,14" Height="112">
                    <StackPanel>
                        <TextBlock Text="可用账号" Style="{StaticResource Overline}" Margin="0" />
                        <TextBlock Text="{Binding Accounts.Count}" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushText}" Margin="0,4,0,0" />
                        <TextBlock Text="离线 / 红石外置登录" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0,0,0,14" Height="112">
                    <StackPanel>
                        <TextBlock Text="联机通道" Style="{StaticResource Overline}" Margin="0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource BrushTerracottaSoft}"
                                    BorderBrush="Transparent">
                                <TextBlock Text="陶瓦" FontSize="11" Foreground="{DynamicResource BrushTerracotta}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource BrushRedstoneSoft}"
                                    BorderBrush="Transparent">
                                <TextBlock Text="红石" FontSize="11" Foreground="{DynamicResource BrushRedstone}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="EasyTier 组网 / Yggdrasil 认证" Style="{StaticResource Hint}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 账号 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="游戏账号" Style="{StaticResource SectionTitle}" />
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Text="离线玩家名" Style="{StaticResource Overline}" Margin="0,14,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OfflinePlayerName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="16" ToolTip="3–16 位英文字母、数字或下划线">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding UseOfflineAccountCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Content="使用离线账号" Command="{Binding UseOfflineAccountCommand}"
                                Style="{StaticResource Primary}" />
                    </Grid>
                    <TextBlock Text="{Binding OfflineAccountStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="红石外置登录账号在【红石联机】页登录后自动出现在上方账号列表。" />
                </StackPanel>
            </Border>

            <!-- 控制台默认收起，首页优先突出启动与版本操作 -->
            <Expander Header="启动输出与工具" IsExpanded="False" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="实时启动日志" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="LIVE" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Foreground="{DynamicResource BrushTextMute}" />
                        </Grid>
                        <TextBox Text="{Binding Log, Mode=OneWay}" Style="{StaticResource LogBox}" MinHeight="150" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="复制启动命令" Command="{Binding CopyPlanCommand}" />
                            <Button Content="清空输出" Command="{Binding ClearLogCommand}" Margin="8,0,0,0" />
                            <Button Content="停止游戏" Command="{Binding StopCommand}" Style="{StaticResource Danger}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>