<UserControl x:Class="MindCraftLauncher.App.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Versions}"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource ScrollablePage}">
        <StackPanel MaxWidth="1060" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="4" Height="26" CornerRadius="2" Background="{DynamicResource BrushAccentGradient}"
                        VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="版本" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,16">
                <Button Content="刷新列表" Command="{Binding RefreshCommand}" />
                <Button Content="去下载新版本" Margin="8,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="download" />
                <Button Content="去装整合包" Margin="8,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="modpacks" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource VersionCardStyle}" GroupName="versionCards"
                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SubTitle}" Style="{StaticResource Hint}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource ChipAccent}" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="0"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="使用中" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushAccent}" />
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                   Foreground="{DynamicResource BrushTextDim}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding JavaLabel}" FontSize="10"
                                                   Foreground="{DynamicResource BrushTextDim}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding InstalledLabel}" Style="{StaticResource Hint}"
                                           FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,0" FontSize="10.5" />

                                <Border Height="1" Background="{DynamicResource BrushDivider}" Margin="0,12,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="启动" Style="{StaticResource Primary}" Padding="14,4" FontSize="12"
                                            MinHeight="28"
                                            Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="目录" Padding="12,4" FontSize="12" MinHeight="28" Margin="6,0,0,0"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="删除" Style="{StaticResource Danger}" Padding="12,4" FontSize="12"
                                            MinHeight="28" Margin="6,0,0,0"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Notice}" Margin="0,4,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ⓘ" FontSize="14" Margin="0,0,9,0" Foreground="{DynamicResource BrushTextMute}" />
                    <TextBlock Style="{StaticResource Hint}" MaxWidth="720"
                               Text="每个版本是一张独立卡片：点卡片切换当前版本，点「启动」直接进游戏，点「删除」只删这个版本目录（不动存档与全局 mods）。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
