<UserControl x:Class="MindCraftLauncher.App.Views.TerracottaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Terracotta}"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource ScrollablePage}">
        <StackPanel MaxWidth="1060" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="4" Height="26" CornerRadius="2" Background="{DynamicResource BrushTerracottaGradient}"
                        VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="陶瓦联机" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="基于 EasyTier 异地组网：房主在游戏里开局域网 → 这里开房拿连接码 → 队友粘贴入网 → 用「虚拟IP:端口」直连。" />

            <Border Style="{StaticResource NoticeWarn}" Margin="0,16,0,0"
                    Visibility="{Binding EasyTierMissing, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" Foreground="{DynamicResource BrushWarn}" FontSize="16" Margin="0,0,10,0"
                               VerticalAlignment="Top" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" MaxWidth="820"
                               Text="没有在本机找到 easytier-core。请到【设置】页指定 EasyTier 目录，或从 easytier.cn 下载命令行版后解压到启动器同级目录。" />
                </StackPanel>
            </Border>

            <!-- 双列：参数 / 结果 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：角色与参数 -->
                <Border Style="{StaticResource CardAccentTerracotta}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="角色" Style="{StaticResource SectionTitle}" />

                        <!-- 分段选择器 -->
                        <Border Background="{DynamicResource BrushInput}" CornerRadius="10" Padding="4"
                                BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Content="我是房主" Style="{StaticResource Segment}"
                                             IsChecked="{Binding IsHost}" GroupName="tcRole" />
                                <RadioButton Grid.Column="2" Content="我加入" Style="{StaticResource Segment}"
                                             IsChecked="{Binding IsJoiner}" GroupName="tcRole" />
                            </Grid>
                        </Border>

                        <TextBlock Text="网络名称" Style="{StaticResource Overline}" Margin="0,14,0,5" />
                        <TextBox Text="{Binding NetworkName}" />

                        <TextBlock Text="网络密钥" Style="{StaticResource Overline}" Margin="0,12,0,5" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="换一个" Command="{Binding NewSecretCommand}"
                                    Style="{StaticResource Ghost}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding NetworkSecret}" FontFamily="{DynamicResource MonoFont}" />
                        </DockPanel>

                        <TextBlock Text="公共节点（--peers）" Style="{StaticResource Overline}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding PublicPeer}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" />

                        <TextBlock Text="游戏局域网端口" Style="{StaticResource Overline}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding LanPortText}" />

                        <TextBlock Text="粘贴房主连接码" Style="{StaticResource Overline}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding JoinCode}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" IsEnabled="{Binding IsJoiner}"
                                 FontFamily="{DynamicResource MonoFont}" FontSize="10.5" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="开房" Command="{Binding StartCommand}" Style="{StaticResource Terracotta}"
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                            <Button Content="入网" Command="{Binding JoinCommand}" Style="{StaticResource Terracotta}"
                                    Visibility="{Binding IsJoiner, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0" />
                            <Button Content="停止" Command="{Binding StopCommand}" Style="{StaticResource Danger}"
                                    Margin="8,0,0,0" />
                            <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 右：组网结果 -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="组网结果" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Margin="0,-2,0,0"
                                        Background="{DynamicResource BrushTerracottaSoft}">
                                    <TextBlock Text="{Binding LinkShort}" FontSize="10"
                                               Foreground="{DynamicResource BrushTerracotta}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="本机虚拟 IP" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding VirtualIp, FallbackValue=—}"
                                           Style="{StaticResource Mono}" FontSize="12.5"
                                           Foreground="{DynamicResource BrushText}" />

                                <TextBlock Grid.Row="1" Text="可连接地址" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Address, FallbackValue=—}"
                                           Style="{StaticResource Mono}" FontSize="12.5" Margin="0,10,0,0"
                                           Foreground="{DynamicResource BrushAccent}" />

                                <TextBlock Grid.Row="2" Text="我的连接码" Style="{StaticResource Hint}"
                                           VerticalAlignment="Top" Margin="0,10,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Code}" IsReadOnly="True"
                                         Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="48"
                                         VerticalContentAlignment="Top" FontFamily="{DynamicResource MonoFont}"
                                         FontSize="10.5" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="复制连接码" Command="{Binding CopyCodeCommand}" />
                                <Button Content="复制地址" Command="{Binding CopyAddressCommand}" Margin="8,0,0,0" />
                                <Button Content="用这个地址启动" Command="{Binding LaunchDirectCommand}"
                                        Style="{StaticResource Primary}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="节点列表" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IPV4" Style="{StaticResource Overline}" Margin="0" />
                                <TextBlock Grid.Column="1" Text="HOSTNAME" Style="{StaticResource Overline}" Margin="0" />
                                <TextBlock Grid.Column="2" Text="COST" Style="{StaticResource Overline}" Margin="0" />
                                <TextBlock Grid.Column="3" Text="LATENCY" Style="{StaticResource Overline}" Margin="0" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Peers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="7"
                                                Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Ipv4}" FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="11" Foreground="{DynamicResource BrushText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Hostname}" FontSize="11"
                                                           Foreground="{DynamicResource BrushTextDim}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Cost}" FontSize="11"
                                                           Foreground="{DynamicResource BrushText}" />
                                                <TextBlock Grid.Column="3" FontSize="11"
                                                           Foreground="{DynamicResource BrushTextMute}"
                                                           Text="{Binding LatencyMs, StringFormat={}{0} ms}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" FontSize="10.5"
                                       Text="cost 为 Local 是自己；p2p 是直连；relay 表示正在走中转（延迟会高）。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="EasyTier 输出" Style="{StaticResource SectionTitle}" />
                            <TextBox Text="{Binding Log, Mode=OneWay}" Style="{StaticResource LogBox}" MinHeight="110" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
