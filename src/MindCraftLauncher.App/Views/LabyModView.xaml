<UserControl x:Class="MindCraftLauncher.App.Views.LabyModView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Download}"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource ScrollablePage}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1060" HorizontalAlignment="Stretch" Margin="24,18,24,24">
            <TextBlock Text="LabyMod" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="浏览 LabyMod 官方发布频道，并将客户端安装为独立 Minecraft 版本。" />

            <Border Style="{StaticResource CardHero}" Margin="0,18,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LABYMOD 4" Style="{StaticResource Overline}" />
                        <TextBlock Text="为你的下一场冒险\n准备客户端" FontSize="25" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,9,0,0"
                                   Text="选择一个 Minecraft 版本，安装后可在【版本】页启动。" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="100" Height="100" CornerRadius="26"
                            Background="{DynamicResource BrushAccentGradient}" VerticalAlignment="Center" Margin="16,0,8,0">
                        <TextBlock Text="L" FontSize="56" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="选择发布频道" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="版本来自 LabyMod 官方发布接口。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox ItemsSource="{Binding LabyChannels}" SelectedItem="{Binding LabyChannel}" MinWidth="160" />
                            <Button Content="刷新版本" Command="{Binding RefreshLabyCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <ListBox MinHeight="150" MaxHeight="300" Margin="0,14,0,0"
                             ItemsSource="{Binding LabyVersions}" SelectedItem="{Binding SelectedLabyRow}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8"
                                            Background="{DynamicResource BrushSurfaceAlt}">
                                        <TextBlock Text="L" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Tag}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushText}" />
                                        <TextBlock Text="{Binding LabyVersion, StringFormat=LabyMod {0}}"
                                                   Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="›" FontSize="22"
                                               Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding ProgressValue}" Margin="0,9,0,0" />
                    <Grid Margin="0,14,0,0">
                        <Button Content="取消安装" Command="{Binding CancelInstallCommand}"
                                HorizontalAlignment="Left" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                        <Button Content="安装所选 LabyMod" Command="{Binding InstallLabyCommand}"
                                Style="{StaticResource Primary}" HorizontalAlignment="Right" MinWidth="210" Padding="22,10" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
