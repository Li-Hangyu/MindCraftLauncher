<UserControl x:Class="MindCraftLauncher.App.Views.ClientPackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource ScrollablePage}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1060" HorizontalAlignment="Left">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Button Content="游戏与加载器" Style="{StaticResource Ghost}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="download" />
                    <Button Content="整合包" Style="{StaticResource Ghost}" Margin="4,0,0,0"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="modpacks" />
                    <Button Content="模组" Style="{StaticResource Ghost}" Margin="4,0,0,0"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="mods" />
                    <Button Content="资源包" Style="{StaticResource Ghost}" Margin="4,0,0,0"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="resourcepacks" />
                    <Button Content="光影包" Style="{StaticResource Ghost}" Margin="4,0,0,0"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="shaders" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="从 Modrinth 搜索并安装到本地 Minecraft 实例。" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                        <ColumnDefinition Width="190" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="搜索内容" Style="{StaticResource Overline}" />
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Minecraft 版本（可空）" Style="{StaticResource Overline}" />
                        <TextBox Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="安装到实例" Style="{StaticResource Overline}" />
                        <ComboBox ItemsSource="{Binding TargetVersions}" SelectedItem="{Binding TargetVersion}" />
                    </StackPanel>
                    <Button Grid.Column="6" Content="搜索" Command="{Binding SearchCommand}"
                            Style="{StaticResource Primary}" VerticalAlignment="Bottom" Padding="20,9" />
                </Grid>
            </Border>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="2,0,0,10" />
            <ItemsControl ItemsSource="{Binding Hits}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource HitCardStyle}" GroupName="clientPackHits"
                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           MaxHeight="46" TextTrimming="CharacterEllipsis" FontSize="10.5"
                                           Foreground="{DynamicResource BrushTextMute}" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="可安装版本" Style="{StaticResource SectionTitle}" />
                        <Button Content="刷新实例" Command="{Binding RefreshTargetsCommand}"
                                HorizontalAlignment="Right" Style="{StaticResource Ghost}" />
                    </Grid>
                    <ListBox Height="170" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                             DisplayMemberPath="Display" />
                    <Button Content="安装所选版本" Command="{Binding InstallCommand}"
                            Style="{StaticResource Primary}" Margin="0,12,0,0" HorizontalAlignment="Right" Padding="22,9" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
