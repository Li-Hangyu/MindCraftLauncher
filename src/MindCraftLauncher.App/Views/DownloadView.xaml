<UserControl x:Class="MindCraftLauncher.App.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Download}"
             Background="Transparent">
    <Grid>
        <ScrollViewer Style="{StaticResource ScrollablePage}" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsDetailVisible, Converter={StaticResource InverseBool}}">
            <StackPanel MaxWidth="1060" HorizontalAlignment="Left">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="游戏与加载器" Style="{StaticResource Ghost}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="download" />
                        <Button Content="整合包" Style="{StaticResource Ghost}" Margin="4,0,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="modpacks" />
                        <Button Content="模组" Style="{StaticResource Ghost}" Margin="4,0,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="mods" />
                        <Button Content="资源包" Style="{StaticResource Ghost}" Margin="4,0,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="resourcepacks" />
                        <Button Content="光影包" Style="{StaticResource Ghost}" Margin="4,0,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="shaders" />
                        <Button Content="LabyMod" Style="{StaticResource Ghost}" Margin="4,0,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="labymod" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="Minecraft 下载" Style="{StaticResource PageTitle}" />

                <Border Style="{StaticResource Inset}" Margin="0,14,0,12" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="搜索版本号"
                                       IsHitTestVisible="False" Margin="13,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextMute}" FontSize="12"
                                       Visibility="{Binding Filter, Converter={StaticResource EmptyToVisible}}" />
                        </Grid>
                        <ComboBox Grid.Column="1" MinWidth="150" Margin="10,0,0,0"
                                  ItemsSource="{Binding DownloadSources}" SelectedItem="{Binding SelectedSource}"
                                  DisplayMemberPath="DisplayName" />
                        <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
                    <StackPanel>
                        <CheckBox Content="允许下载游戏本体（版本 jar / 库 / 资源文件）" IsChecked="{Binding GameDownloadEnabled}" />
                        <Border Style="{StaticResource NoticeWarn}" Margin="0,9,0,0"
                                Visibility="{Binding ComplianceVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="文件仅从 Mojang 官方分发端点或公开镜像获取。继续前请确认来源说明。" />
                                <CheckBox Content="我已了解以上来源与用途" IsChecked="{Binding AcknowledgeCompliance}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="最新版本" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" FontSize="18" />

                <ItemsControl ItemsSource="{Binding TestVersions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource VersionCardStyle}" GroupName="latestVersions"
                                         HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="14,10"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.OpenVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="7" Background="{DynamicResource BrushSurfaceAlt}">
                                        <TextBlock Text="◆" Foreground="{DynamicResource BrushAccent}" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="正式版" IsExpanded="True" Margin="0,8,0,10">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="正式版" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
                        </DataTemplate>
                    </Expander.HeaderTemplate>
                    <ItemsControl ItemsSource="{Binding ReleaseVersions}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource VersionCardStyle}" GroupName="releaseVersions"
                                             Width="220" Padding="12" Margin="0,0,10,10"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.OpenVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource BrushSurfaceAlt}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding InstallState}" Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="10" />
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <ProgressBar Value="{Binding ProgressValue}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,7,0,0"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

            <!-- 版本详情页：覆盖下载列表并填满内容区 -->
            <Grid Margin="26,20,26,26" Background="{DynamicResource BrushWindowGradient}"
                  Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="←" Command="{Binding BackToVersionsCommand}" Style="{StaticResource Ghost}"
                            Width="42" Height="42" FontSize="18" />
                    <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="7" Background="{DynamicResource BrushSurfaceAlt}">
                            <TextBlock Text="◆" Foreground="{DynamicResource BrushAccent}" FontSize="19"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBox Grid.Column="1" Text="{Binding DetailVersion.Id, Mode=OneWay}" IsReadOnly="True" Margin="8,0,0,0" />
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding LoaderOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Inset}" Margin="0,0,0,8" Padding="4">
                                        <Button Style="{StaticResource Ghost}" Padding="12,10"
                                                Command="{Binding DataContext.SelectLoaderKindCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Kind}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Kind}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="1" Text="{Binding Availability}" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Notice}" Margin="0,2,0,8"
                                Visibility="{Binding IsForge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Forge 安装器需要 Java。若自动检测未找到兼容版本，请在设置中指定 Java。" />
                        </Border>
                        <Grid Margin="0,2,0,8">
                            <TextBlock Text="{Binding LoaderStatus}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            <Button Content="刷新版本" Command="{Binding RefreshLoadersCommand}"
                                    Visibility="{Binding ShowLoaderOptions, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right" />
                        </Grid>
                        <ListBox Height="170" ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding SelectedLoader}"
                                 DisplayMemberPath="Display"
                                 Visibility="{Binding ShowLoaderOptions, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding ProgressValue}" Margin="0,8,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Button Content="取消" Command="{Binding CancelInstallCommand}"
                                HorizontalAlignment="Left" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{Binding InstallActionLabel}" Command="{Binding InstallLoaderCommand}"
                                Style="{StaticResource Primary}" HorizontalAlignment="Right"
                                MinWidth="180" Padding="26,10" />
                    </Grid>
                </StackPanel>
            </Grid>

            </Grid>
        </UserControl>
