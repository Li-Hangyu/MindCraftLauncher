<UserControl x:Class="MindCraftLauncher.App.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushWindowGradient}">
    <ScrollViewer Style="{StaticResource ScrollablePage}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1060" HorizontalAlignment="Left">
            <Button Content="← 返回搜索结果" Command="{Binding BackCommand}" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Left" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardHero}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="84" Height="84" CornerRadius="16" Background="{DynamicResource BrushSurfaceAlt}">
                        <Image Source="{Binding SelectedHit.IconUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedHit.Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding SelectedHit.Summary}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedHit.Description}" Style="{StaticResource Hint}"
                                   TextWrapping="Wrap" MaxHeight="72" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="支持的 Minecraft 版本" Style="{StaticResource SectionTitle}" />
                    <ComboBox ItemsSource="{Binding SupportedGameVersions}" SelectedItem="{Binding SelectedGameVersion}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="版本标记的加载器" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="1" Text="{Binding DetectedLoaders}" Foreground="{DynamicResource BrushAccent}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Visibility="{Binding ShowTargetVersion, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                        <TextBlock Text="安装到的 Minecraft 实例" Style="{StaticResource Overline}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding TargetVersions}" SelectedItem="{Binding TargetVersion}" />
                    </StackPanel>
                    <TextBlock Text="可安装版本" Style="{StaticResource SectionTitle}" Margin="0,14,0,0" />
                    <ListBox Height="190" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                             DisplayMemberPath="Display" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,9,0,0" TextWrapping="Wrap" />
                    <Button Content="安装所选版本" Command="{Binding InstallCommand}"
                            Style="{StaticResource Primary}" Margin="0,12,0,0" HorizontalAlignment="Right" Padding="22,9" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
