<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MindCraftLauncher.App.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        设计令牌：与颜色无关的部分（字体、字号、圆角、间距、时长、阴影）。
        深浅主题只替换 Dark.xaml / Light.xaml，这里的键在两边都不用改。
    -->

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:StringEmptyToVisibilityConverter x:Key="EmptyToVisible" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVisible" />

    <!-- 字体：优先中文界面字体，逐级回退 -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, PingFang SC, Noto Sans CJK SC</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, JetBrains Mono, Courier New</FontFamily>
    <FontFamily x:Key="DisplayFont">Microsoft YaHei UI, Segoe UI</FontFamily>

    <sys:Double x:Key="FontSizeHero">27</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11.5</sys:Double>
    <sys:Double x:Key="FontSizeTiny">10.5</sys:Double>

    <Thickness x:Key="GapCard">16</Thickness>
    <Thickness x:Key="GapField">0,7,0,0</Thickness>
    <Thickness x:Key="GapPage">26,20,26,26</Thickness>
    <Thickness x:Key="BorderCard">1</Thickness>

    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusCardSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusField">8</CornerRadius>
    <CornerRadius x:Key="RadiusButton">9</CornerRadius>

    <Duration x:Key="FadeFast">0:0:0.13</Duration>
    <Duration x:Key="FadeNormal">0:0:0.22</Duration>
    <Duration x:Key="FadeSlow">0:0:0.38</Duration>

    <!-- 卡片阴影：深色主题下靠一点点外扩营造层次，浅色主题下更淡 -->
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="22" ShadowDepth="5" Direction="270"
                      Opacity="0.30" Color="#FF000000" RenderingBias="Performance" />
    <DropShadowEffect x:Key="ShadowPop" BlurRadius="34" ShadowDepth="10" Direction="270"
                      Opacity="0.42" Color="#FF000000" RenderingBias="Performance" />

    <!-- 陶瓦 / 红石两套通道色（不随主题变化，只作为识别色） -->
    <Color x:Key="ColorTerracotta">#FF8A5B</Color>
    <Color x:Key="ColorRedstone">#FF5D6C</Color>

</ResourceDictionary>
