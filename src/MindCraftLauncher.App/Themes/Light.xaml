<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        浅色主题「Paper Light」。
        键名必须与 Dark.xaml 一一对应，ThemeManager 才能原位替换而不丢资源。
    -->

    <!-- 底色 -->
    <SolidColorBrush x:Key="BrushWindow" Color="#F4F6FB" />
    <SolidColorBrush x:Key="BrushWindowDeep" Color="#E8ECF6" />
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#F6F8FD" />
    <SolidColorBrush x:Key="BrushElevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushHover" Color="#EDF1FA" />
    <SolidColorBrush x:Key="BrushBorder" Color="#E0E7F3" />
    <SolidColorBrush x:Key="BrushBorderSoft" Color="#EDF1F8" />
    <SolidColorBrush x:Key="BrushDivider" Color="#E8EDF6" />
    <SolidColorBrush x:Key="BrushInput" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushNavSelected" Color="#EAEFFE" />
    <SolidColorBrush x:Key="BrushScrollThumb" Color="#C7D0E0" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="BrushText" Color="#111828" />
    <SolidColorBrush x:Key="BrushTextDim" Color="#5A6478" />
    <SolidColorBrush x:Key="BrushTextMute" Color="#8B94A7" />
    <SolidColorBrush x:Key="BrushTextOnAccent" Color="#FFFFFF" />

    <!-- 强调色与语义色 -->
    <SolidColorBrush x:Key="BrushAccent" Color="#4F6BFF" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="#3B58EE" />
    <SolidColorBrush x:Key="BrushAccent2" Color="#8B5CF6" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#E9EEFF" />
    <SolidColorBrush x:Key="BrushOk" Color="#0E9E68" />
    <SolidColorBrush x:Key="BrushWarn" Color="#B87B06" />
    <SolidColorBrush x:Key="BrushErr" Color="#DA4747" />

    <!-- 两条联机通道的识别色 -->
    <SolidColorBrush x:Key="BrushTerracotta" Color="#DF6B3A" />
    <SolidColorBrush x:Key="BrushRedstone" Color="#DA3D4D" />
    <SolidColorBrush x:Key="BrushTerracottaSoft" Color="#FFF1EA" />
    <SolidColorBrush x:Key="BrushRedstoneSoft" Color="#FFEDEF" />

    <!-- 渐变 -->
    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F6BFF" Offset="0" />
        <GradientStop Color="#6E62FF" Offset="0.52" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushAccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B58EE" Offset="0" />
        <GradientStop Color="#5A4DF0" Offset="0.52" />
        <GradientStop Color="#7746E8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushTerracottaGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E9762F" Offset="0" />
        <GradientStop Color="#E2557A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushRedstoneGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DA3D4D" Offset="0" />
        <GradientStop Color="#E9762F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushRailSelected" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E4EBFF" Offset="0" />
        <GradientStop Color="#F0E7FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E9EEFF" Offset="0" />
        <GradientStop Color="#F1E9FF" Offset="0.45" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushTopBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F7F9FE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushWindowGradient" StartPoint="0,0" EndPoint="0.9,1">
        <GradientStop Color="#F8FAFF" Offset="0" />
        <GradientStop Color="#EEF2FA" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="BrushAuroraA" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#334F6BFF" Offset="0" />
        <GradientStop Color="#144F6BFF" Offset="0.55" />
        <GradientStop Color="#004F6BFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BrushAuroraB" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#288B5CF6" Offset="0" />
        <GradientStop Color="#108B5CF6" Offset="0.55" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BrushGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#F2FFFFFF" Offset="0.4" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
